# Client (Vite — only VITE_* is exposed to the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Comma-separated admin Gmails
VITE_ADMIN_EMAILS=you@gmail.com
# YouTube Data API v3 browser key (restrict by HTTP referrer)
VITE_YOUTUBE_API_KEY=your_youtube_api_key

# After creating the project, run supabase/schema.sql in the SQL Editor
# so Admin → Cloud push/pull works.

# Server-only (never prefix with VITE_ — not for browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=
DIRECT_URL=
