# Client (Vite — only VITE_* is exposed to the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Comma-separated admin Gmails (merged with built-in defaults in code)
VITE_ADMIN_EMAILS=d.monkh2007@gmail.com,Tsbatbaatar99@gmail.com
# YouTube Data API v3 browser key (restrict by HTTP referrer)
VITE_YOUTUBE_API_KEY=your_youtube_api_key

# After creating the project, run supabase/schema.sql in the SQL Editor
# so Admin → Cloud push/pull works.

# Signup OTP (6-digit code):
# Authentication → Email Templates → Confirm signup
# Include {{ .Token }} in the body (and optionally hide the link).
# Subject example: newsac.mn · баталгаажуулах код
# For From: newsac.mn, set Custom SMTP (Authentication → SMTP Settings).
# Enable "Confirm email" under Authentication → Providers → Email.

# Instagram live Stories on the home rail (server-only secrets):
# 1) Convert @newsac_channel to Instagram Professional + link a Facebook Page
# 2) Meta Developer App → Instagram Graph API → long-lived Page token
# 3) Get IG_USER_ID from the Page's linked Instagram business account
# 4) supabase secrets set IG_ACCESS_TOKEN=... IG_USER_ID=... IG_USERNAME=newsac_channel
# 5) supabase functions deploy instagram-stories --no-verify-jwt
# Until configured, the Instagram story chip opens Instagram Stories in a new tab.

# YouTube Posts (/posts) — no official API. Dev uses Vite /api/youtube-posts.
# Production: supabase functions deploy youtube-posts --no-verify-jwt
# Optional secret: YT_CHANNEL_ID=UCZASN1yt7rHU0Xj6ywmZJQA

# Server-only (never prefix with VITE_ — not for browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=
DIRECT_URL=
